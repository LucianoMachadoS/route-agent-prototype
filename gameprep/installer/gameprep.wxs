<?xml version="1.0" encoding="utf-8"?>
<!--
  GamePrep installer (WiX v7). Built by build-msi.ps1, which passes:
    Version  - from gameprep/Cargo.toml
    ExePath  - the release gameprep.exe
    IconPath - the .ico written by gameprep.exe's write-icon option
               (XML comments can't contain a double dash, hence no flag here)

  UpgradeCode must NEVER change: it's what makes a newer MSI replace an
  installed older one (MajorUpgrade) instead of installing side by side.

  Installs per-machine to Program Files (one UAC prompt, at install time
  only). GamePrep itself always runs as the normal user.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="GamePrep"
           Manufacturer="Luciano Machado"
           Version="$(var.Version)"
           UpgradeCode="D08ED154-ADB7-43D0-8D6F-CA9AB8E2AF35"
           Scope="perMachine"
           Language="1046"
           Codepage="1252">

    <MajorUpgrade DowngradeErrorMessage="Uma versão mais nova do GamePrep já está instalada." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="GamePrepIcon" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="GamePrepIcon" />
    <Property Id="ARPCOMMENTS" Value="Otimizador de Windows para jogos: fecha apps de segundo plano quando um jogo abre." />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="GamePrep" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="GamePrep">
      <Component Id="MainExe" Directory="INSTALLFOLDER">
        <File Id="GamePrepExe" Source="$(var.ExePath)" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut"
                    Name="GamePrep"
                    Description="Otimizador de Windows para jogos"
                    Directory="ProgramMenuFolder"
                    WorkingDirectory="INSTALLFOLDER"
                    Icon="GamePrepIcon"
                    Advertise="yes" />
        </File>
      </Component>

      <!--
        "Start with Windows" for the installing user. The MSI owns this
        value so uninstalling removes it; the app's own on/off switch only
        flips Task Manager's StartupApproved flag next to it, so the two
        never fight over the same value.
      -->
      <Component Id="Autostart" Directory="INSTALLFOLDER">
        <RegistryValue Root="HKCU"
                       Key="Software\Microsoft\Windows\CurrentVersion\Run"
                       Name="GamePrep"
                       Type="string"
                       Value="&quot;[INSTALLFOLDER]gameprep.exe&quot; --minimized"
                       KeyPath="yes" />
      </Component>
    </Feature>

    <!--
      Start GamePrep right after a fresh install. Immediate + after
      InstallFinalize = runs in the (non-elevated) client process, so the
      app never inherits the installer's admin rights.
    -->
    <CustomAction Id="LaunchGamePrep"
                  FileRef="GamePrepExe"
                  ExeCommand=""
                  Execute="immediate"
                  Impersonate="yes"
                  Return="asyncNoWait" />
    <InstallExecuteSequence>
      <Custom Action="LaunchGamePrep" After="InstallFinalize" Condition="NOT Installed AND NOT REMOVE" />
    </InstallExecuteSequence>
  </Package>
</Wix>
