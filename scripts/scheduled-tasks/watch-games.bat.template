@echo off
REM TEMPLATE ONLY. Copy to C:\ProgramData\RouteAgent\watch-games.bat and
REM run scripts\install.ps1 (elevated) - it installs the exe and games.toml
REM where this .bat expects them, admin-only. See README.
REM Prefer this over watch-game.bat.template once you have more than one
